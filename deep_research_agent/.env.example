# Deep Research Agent — Environment Variables
# Copy this file to .env and fill in your real keys.
# Never commit .env to version control.

# ── Groq (Llama 3.3 70B) ──────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Tavily Search ─────────────────────────────────────────────────────────────
# Get your key at: https://app.tavily.com/home
# Free tier: 1,000 searches/month
TAVILY_API_KEY=your_tavily_api_key_here

# ── LangSmith tracing (OPTIONAL — off unless uncommented) ─────────────────────
# Traces the whole run (all four LLM nodes + the LangGraph structure) with no code
# changes: LangChain auto-traces once these are set. See README "Observability".
# Get a key at: https://smith.langchain.com/  (Settings → API Keys)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=deep-research-agent
